{
  "name": "alaa-ali-educational-platform",
  "version": "1.0.0",
  "description": "Bilingual educational platform with Arabic/English support deployed on Railway",
  "main": "index.js",
  "scripts": {
    "install:backend": "cd backend && npm install",
    "install:frontend": "cd frontend && npm install",
    "install:all": "npm run install:backend && npm run install:frontend",
    "dev:backend": "cd backend && npm run dev",
    "dev:frontend": "cd frontend && npm run dev",
    "dev:all": "concurrently \"npm run dev:backend\" \"npm run dev:frontend\"",
    "build:frontend": "cd frontend && npm run build",
    "start:backend": "cd backend && npm start",
    "seed:backend": "cd backend && npm run seed",
    "test:backend": "cd backend && npm test",
    "test:frontend": "cd frontend && npm test",
    "test:e2e": "./test-e2e-integration.sh",
    "test:all": "npm run test:backend && npm run test:frontend",
    "clean": "rm -rf node_modules backend/node_modules frontend/node_modules backend/dist frontend/dist",
    "deploy:railway": "echo 'Deploy to Railway - Follow DEPLOYMENT.md instructions'"
  },
  "keywords": [
    "education",
    "bilingual",
    "arabic",
    "english",
    "railway",
    "mongodb",
    "react",
    "nodejs",
    "educational-platform"
  ],
  "author": "Alaa-Ali",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/your-username/alaa-ali-educational-platform"
  },
  "devDependencies": {
    "concurrently": "^8.2.0"
  },
  "engines": {
    "node": ">=16.0.0",
    "npm": ">=8.0.0"
  },
  "workspaces": [
    "backend",
    "frontend"
  ]
}