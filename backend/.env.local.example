# Backend Local Development Environment Variables

# MongoDB connection string for local development
MONGODB_URI=mongodb://localhost:27017/bilingual_edu_dev

# JWT secret key for local development
JWT_SECRET=your_local_jwt_secret_key_here

# OpenAI API key for local development
OPENAI_API_KEY=your_local_openai_api_key_here

# Server port for local development
PORT=5000

# CORS origin for local development
CORS_ORIGIN=http://localhost:3000