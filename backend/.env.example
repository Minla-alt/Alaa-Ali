# MongoDB Atlas Connection String
# Replace with your actual MongoDB Atlas connection string
# Format: mongodb+srv://username:password@cluster-name.mongodb.net/database-name
MONGODB_URI=mongodb+srv://username:password@cluster0.xxxxxx.mongodb.net/educational_platform?retryWrites=true&w=majority

# Server Configuration
# Railway will automatically set PORT, but you can specify a fallback
PORT=3001
NODE_ENV=development

# Production Security
# ⚠️ IMPORTANT: Generate a strong secret (32+ characters)
# You can use: openssl rand -base64 32
JWT_SECRET=your-super-secret-jwt-key-must-be-32-characters-minimum-change-in-production

# CORS Configuration for Production
# Separate multiple domains with commas, e.g., https://yourdomain.com,https://www.yourdomain.com
# For Railway: This will be your Railway app URL
CORS_ORIGIN=https://your-railway-app.railway.app

# Rate Limiting Configuration
# Production: 500 requests per 15 minutes
# Development: 100 requests per 15 minutes
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=500

# OpenAI API Configuration
# Get your API key from: https://platform.openai.com/api-keys
OPENAI_API_KEY=your-openai-api-key-here
OPENAI_MODEL=gpt-3.5-turbo

# Recommendation Rate Limiting (1 hour in milliseconds)
RECOMMENDATION_RATE_LIMIT_MS=3600000

# Database Seeding Configuration
# Set to 'true' to skip confirmation and clear data before seeding
# ⚠️ WARNING: Only use in development!
SEED_CLEAR_DATA=false

# Additional Production Environment Variables
# NODE_ENV=production (Railway will set this automatically)
# LOG_LEVEL=error (optional: error, warn, info, debug)
