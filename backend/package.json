{
  "name": "bilingual-educational-platform",
  "version": "1.0.0",
  "description": "Backend for bilingual educational platform with MongoDB and Mongoose",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
    "seed": "node src/scripts/seed.js",
    "test:db": "node src/scripts/test-connection.js",
    "setup": "npm install && npm run test:db && npm run seed",
    "setup:full": "npm install && npm run test:db && echo 'Database setup complete! Now run: npm run dev'"
  },
  "keywords": [
    "education",
    "bilingual",
    "mongodb",
    "mongoose",
    "nodejs"
  ],
  "author": "Alaa-Ali",
  "license": "MIT",
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-rate-limit": "^6.8.1",
    "helmet": "^7.0.0",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^7.5.0",
    "openai": "^4.20.1"
  },
  "devDependencies": {
    "nodemon": "^3.0.1"
  },
  "engines": {
    "node": ">=16.0.0"
  }
}
