{
  "build": {
    "builder": "NIXPACKS"
  },
  "deploy": {
    "startCommand": "npm start",
    "healthcheckPath": "/api/health",
    "healthcheckTimeout": 100,
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 10
  },
  "environments": {
    "backend": {
      "variables": {
        "NODE_ENV": "production",
        "NPM_CONFIG_PRODUCTION": "false"
      }
    }
  }
}